DATABASE_URL=postgresql+psycopg://halfspace:halfspace@localhost:5432/halfspace
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
SEARCH_LLM_MODEL=gpt-4o-mini
SEARCH_EMBEDDING_MODEL=text-embedding-3-small
SEARCH_CROSS_ENCODER=cross-encoder/ms-marco-MiniLM-L-6-v2
# USD per million input/output tokens; OpenAI defaults for the model choices above
SEARCH_COST_INPUT_PER_MILLION=0.15
SEARCH_COST_OUTPUT_PER_MILLION=0.60
SEARCH_EMBEDDING_COST_PER_MILLION=0.02
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_ENABLED=false
# Optional OTLP HTTP collector URL; enables spans when Langfuse credentials are absent
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SCOUT_MAX_ROWS=200
SCOUT_STATEMENT_TIMEOUT_MS=3000
SCOUT_MAX_ROUNDS=2
STATS_BOMB_DATA_URL=https://raw.githubusercontent.com/statsbomb/open-data/master/data
# Optional space-separated competition IDs, e.g. "2 11"
COMPETITION_IDS=
